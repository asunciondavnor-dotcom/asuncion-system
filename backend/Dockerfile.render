# Render serves PR-PO verification from pinned private model images.
ARG APPROVED_MODEL_IMAGE=ghcr.io/asunciondavnor-dotcom/asuncion-approved-models@sha256:ab17ebc3a697568a4a3fcafd7af686d7e7e258bda36c7b7e33817da9007356ee
ARG PR_PO_MODEL_IMAGE=ghcr.io/asunciondavnor-dotcom/asuncion-approved-models@sha256:f6217fd6ee05fcf3423acae0df979f3b69deb82d24d3284cc8359c304cf035a2
ARG PR_PO_FASTTEXT_IMAGE=ghcr.io/asunciondavnor-dotcom/asuncion-approved-models@sha256:0eb5a82baa49ae72866e93708ac90a48b52fe97ea733af85c3ca560fb7b0e7ca
FROM ${PR_PO_FASTTEXT_IMAGE} AS fasttext
FROM ${APPROVED_MODEL_IMAGE} AS approved_models
FROM ${PR_PO_MODEL_IMAGE} AS pr_po_model

FROM python:3.13.16-slim-bookworm AS source
WORKDIR /source
# Build from the repository root. The manifest validates the staged runtime paths.
COPY backend/ /source/
COPY frontend/templates/ /source/templates/
COPY frontend/static/ /source/static/
RUN python -B deploy/render_delivery.py /runtime

FROM python:3.13.16-slim-bookworm AS runtime
ARG PR_PO_FASTTEXT_MANIFEST_SHA256=a378bb6187dd4af679d93de49040175ad2b56c857f16b46c62540a4e581784da
ENV PSMS_PR_PO_FASTTEXT_MANIFEST_SHA256=${PR_PO_FASTTEXT_MANIFEST_SHA256} \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PSMS_ENV=production PORT=10000 PSMS_BIND_HOST=0.0.0.0 PSMS_THREADS=2 \
    PSMS_DATA_DIR=/tmp/psms HOME=/tmp \
    PSMS_NLP_RUNTIME=retrained_rf PSMS_INFERENCE_ENABLED=1 \
    PSMS_INFERENCE_RELEASE_ID=nlp-online-original-v2 PSMS_INFERENCE_CACHE_ENABLED=0 \
    PSMS_PR_PO_FASTTEXT=1 MALLOC_ARENA_MAX=2 \
    PSMS_PRODUCTION_DB_ENABLED=0 PSMS_DURABLE_WORKBOOKS_ENABLED=1 \
    PSMS_DB_SSLROOTCERT=/app/certs/supabase-ca.crt \
    TESSERACT_CMD=/usr/bin/tesseract PSMS_RENDER_OCR_BUDGET=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_DATASETS_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false \
    OMP_THREAD_LIMIT=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates libgomp1 tesseract-ocr tesseract-ocr-eng fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system psms \
    && useradd --system --gid psms --home-dir /app psms \
    && mkdir -p /tmp/psms && chown psms:psms /tmp/psms
WORKDIR /app
COPY --from=source /runtime/deploy/requirements-staging-linux-amd64.lock.txt /runtime/deploy/requirements-fasttext.lock.txt /app/deploy/
RUN pip install --no-cache-dir --only-binary=:all: --no-deps \
       -r /app/deploy/requirements-staging-linux-amd64.lock.txt \
       --constraint /app/deploy/requirements-fasttext.lock.txt \
       -r /app/deploy/requirements-fasttext.lock.txt && pip check
COPY --from=source /runtime/ /app/
COPY --from=approved_models --chmod=0555 /inference_releases/nlp-online-original-v2/ /app/inference_releases/nlp-online-original-v2/
COPY --from=pr_po_model --chmod=0444 /inference_releases/asuncion-minilm-linear-svm-v1/minilm-fp32.ort /app/inference_releases/asuncion-minilm-linear-svm-v1/minilm-fp32.ort
COPY --from=fasttext --chmod=0555 /serving/ /app/inference_releases/asuncion-fasttext-calibrated-svm-v1/
RUN chmod 0555 /app/inference_releases/asuncion-minilm-linear-svm-v1 \
    && chmod 0444 /app/certs/supabase-ca.crt
USER psms
RUN python -B deploy/render_image_check.py
EXPOSE 10000
# Render health check: /health/live. No migrations, bootstraps or downloads.
# Existing launcher uses Waitress, one process, and the Render-supplied $PORT.
CMD ["python", "deploy/render_start.py"]
